---
// The public token page. It shows what GET /api/token returned and nothing else: the address,
// the configured tiers and the links all come from the API. Not launched is a state of its own:
// no address, no link, one plain sentence. docs/contracts/phase-4-token.md rule 13.
//
// The head says what the token is and, in a chip, whether it exists yet. Beside it a panel holds
// the one thing a visitor can do with it: read or copy the address. Under them, while the tiers
// are on, "Open to holders now" says what each tier unlocks in whole tokens, perk by perk, with the
// tier table folded into it, and "Next for holders" names what comes (docs/contracts/phase-6-holders.md
// section 2, revision 5, D1); while GET /api/polls lists the holders' poll as open, its line stands under
// "The holders' poll is open" instead (POLL-DC-3; the heading's words since revision 8g, H6). Where that table does not show, the tier table stands in its place,
// so a person compares what each share of the supply unlocks. After them, once the
// token is launched, one block says what holding it unlocks in FOREHEAD, the founder's game. The
// page ends with its risks, in the same sentences as before.
import { foreheadFacts, grouped, links } from '../../content/facts.ts';
import { text } from '../../content/index.ts';
import Address from '../../design/Address.astro';
import Button from '../../design/Button.astro';
import Chip from '../../design/Chip.astro';
import FigureBand from '../../design/FigureBand.astro';
import Layout from '../../design/Layout.astro';
import Notice from '../../design/Notice.astro';
import Panel from '../../design/Panel.astro';
import Table from '../../design/Table.astro';
import { readAccount } from '../../lib/account.ts';
import PageHead from '../PageHead.astro';
import { pollsIsOn, readPolls } from '../polls/read-polls.ts';
import ShareMeta from '../ShareMeta.astro';
import { siteShareImage } from '../share.ts';
import { formatFeedDelay } from './feed-delay.ts';
import HoldersTable from './HoldersTable.astro';
import { badgeValue, holderAmounts, pollOpenNow, wholeAmount } from './holders.ts';
import { ownerHoldsOn as readOwnerHoldsOn, picturesOn as readPicturesOn } from './holders-reads.ts';
import { readTokenResult } from './read-token.ts';

const account = await readAccount(Astro);
const result = await readTokenResult(Astro);
const info = result.ok ? result.info : null;

// What holding gives, in whole tokens (docs/contracts/phase-6-holders.md section 2). Only while the
// tiers are on and the API's table names all three amounts: "Open to holders now" would not be true
// with the tiers switched off, and an amount is never a figure of the page's own. The pictures row
// and the owner-holds row each follow a read of the API (holders-reads.ts); the link to the poll
// follows its status probe. A read that fails is "no".
const holderTiers = info?.tiers ?? [];
const amounts = holderAmounts(holderTiers);
const showHolders = Boolean(info?.gatingOn && amounts);
const [picturesOn, ownerHoldsOn, pollsSwitch] = showHolders
  ? await Promise.all([readPicturesOn(Astro), readOwnerHoldsOn(Astro), pollsIsOn(Astro)])
  : [false, false, 'off' as const];
const pollLink = pollsSwitch === 'on';
// While GET /api/polls lists the poll as open, its line stands under "The holders' poll is open" and "Next for
// holders" keeps the Strategy Coach alone (POLL-DC-3). Upcoming, none open or a failed read: as before.
const pollsRead = pollLink ? await readPolls(Astro) : null;
const pollNow = pollOpenNow(pollsSwitch, pollsRead);
const pollLine = amounts
  ? text(
      'token.holdersNextPoll',
      "The holders' poll: wallets holding at least {amount} $PRIX choose between options Prix writes for its paper league.",
      { amount: wholeAmount(amounts[0]) },
    )
  : '';
const pollLinkLabel = text('token.holdersNextPollLink', "See the holders' poll");

const title = text('token.sitePageTitle', 'The Prix token');
const lead = text(
  'token.lead',
  'A token on Robinhood Chain that sets how many agents a wallet can run and how soon it sees the live feed.',
);

// Formatting only: the thresholds are the API's own numbers, shown as a share of the supply.
const percent = (ppm: number): string => `${Number((ppm / 10_000).toFixed(4))}%`;
const whole = (value: number): string => value.toLocaleString('en-US');

const yes = text('token.yes', 'Yes');
const no = text('token.no', 'No');
// The tier table stands only where "Open to holders now" does not (revision 5, D1): while that table shows,
// its badge row, its "Tier {tier}" headers and the badge line beneath it say all the tier table said, in
// whole tokens. Where it does not show (the tiers off, or an amount missing from the API's table), the tier
// table stands whole, as before.
const columns = [
  { key: 'tier', label: text('token.colTier', 'Tier') },
  { key: 'hold', label: text('token.siteColHold', 'Holding, share of supply'), align: 'end' as const },
  { key: 'agents', label: text('token.siteColAgents', 'Agents'), align: 'end' as const },
  { key: 'feed', label: text('token.siteColFeed', 'Feed') },
  { key: 'badge', label: text('token.siteColBadge', 'Badge') },
  { key: 'api', label: text('token.siteColApi', 'Free API calls a day'), align: 'end' as const },
];
const tiers = info?.tiers ?? [];

const launched = Boolean(info?.tokenAddress);
const stateLabel = launched
  ? text('token.siteStateLaunched', 'Launched on Pons')
  : text('token.siteStateNotLaunched', 'Not launched');

// What $PRIX unlocks in FOREHEAD, the founder's game (D-146), after the tier table. Only once the
// token is launched: the block speaks of "the address above", which a page with no address (not
// launched, or a read that failed) does not show. Its line that sets the game's own amounts apart
// from "the tiers above" stands only where the tier table stands. The amounts are facts of the
// game (`foreheadFacts`), whole tokens, never Prix's tiers. The link opens in the same tab and
// carries no `rel`, as the footer's does (DESIGN.md R16). It is a plain block on the ground, as
// the risks under it are, so the two stand one section gap apart after the raised tier table.
const showForehead = launched;

const noPromise = text(
  'token.notAPromise',
  'Holding the token is not a promise of return, profit or gain of any kind, and it is not an investment.',
);
const notAdvice = text(
  'token.notAdvice',
  'In the league, what an agent decides is the record of a simulation, and no real orders are placed. Nothing an agent decides is advice.',
);
const disclosureUrl = text('common.stockTokensDisclosureUrl', 'https://docs.robinhood.com/rhj');
---

<Layout title={title} description={lead} current="token" account={account}>
  <ShareMeta slot="head" title={title} description={lead} image={siteShareImage()} />

  <div class="page site-top with-panel token-top">
    <PageHead title={title} lead={lead}>
      {info && <Chip label={stateLabel} kind="neutral" />}
    </PageHead>

    {
      info ? (
        <Panel title={text('token.addressTitle', 'Contract address')} id="token-address">
          {info.tokenAddress ? (
            <div class="stack-8">
              <Address
                value={info.tokenAddress}
                copyLabel={text('token.siteCopyAddress', 'Copy address')}
                copiedLabel={text('token.siteCopied', 'Address copied.')}
                failedLabel={text('token.siteCopyFailed', 'Copying was blocked. Select the address and copy it by hand.')}
              />
              <p class="small">
                {text(
                  'token.notPrize',
                  'Names on Pons are not unique: this address is the only one that counts.',
                )}
              </p>
            </div>
          ) : (
            <p class="body">
              {text(
                'token.notLaunched',
                'The Prix token has not launched. No address exists yet, and any token that claims to be it is not.',
              )}
            </p>
          )}
          {(info.explorerUrl || info.buyUrl) && (
            <ul class="panel-part token-links" role="list">
              {info.explorerUrl && (
                <li>
                  <a href={info.explorerUrl} rel="noopener noreferrer" target="_blank">
                    {text('token.explorerLink', 'View the token on the explorer')}
                  </a>
                </li>
              )}
              {info.buyUrl && (
                <li>
                  <a href={info.buyUrl} rel="noopener noreferrer" target="_blank">
                    {text('token.siteBuyLink', 'Open the token on Pons')}
                  </a>
                </li>
              )}
            </ul>
          )}
          <div class="panel-part">
            <FigureBand
              plain
              label={text('token.siteStateLabel', 'The token today')}
              items={[
                {
                  label: text('token.siteStateTiers', 'Tiers'),
                  value: info.gatingOn
                    ? text('token.siteStateTiersOn', 'Switched on')
                    : text('token.siteStateTiersOff', 'Switched off'),
                },
                {
                  label: text('token.siteStateTicker', 'Ticker'),
                  value: text('token.siteStateTickerName', '$PRIX'),
                },
              ]}
            />
          </div>
        </Panel>
      ) : (
        <Notice
          tone="error"
          title={text('token.errorTitle', 'The token details could not be loaded')}
          body={text('token.errorBody', 'Nothing here has changed. Reload the page in a minute.')}
        />
      )
    }

    <div class="token-about">
      <section class="stack-8" aria-labelledby="token-for-title">
        <h2 class="title" id="token-for-title">{text('token.forTitle', 'What it is for')}</h2>
        <p class="prose">
          {text(
            'token.forBody',
            'It is a key to features: more agent slots, the live feed without the delay, a verified badge and a larger data quota. It is not needed to watch the league.',
          )}
        </p>
      </section>

      <section class="stack-8" aria-labelledby="token-not-title">
        <h2 class="title" id="token-not-title">{text('token.notTitle', 'What it is not')}</h2>
        <p class="prose">{noPromise}</p>
        <ul class="token-list" role="list">
          <li>
            {text(
              'token.notRights',
              "It gives no rights in Prix: no ownership, no claim on anything the site makes, and no vote on how Prix or the token is run. The holders' poll only chooses between options Prix writes for its paper league.",
            )}
          </li>
          <li>{text('token.notShare', 'It gives no share of revenue. Prix pays holders nothing.')}</li>
          <li>{text('token.notLink', 'It has no link to any agent’s decisions. An agent doing well or badly changes nothing about the token.')}</li>
        </ul>
        <p class="prose">{notAdvice}</p>
      </section>
    </div>
  </div>

  {
    !showHolders && info && tiers.length > 0 && (
      <div class="zone zone--raised"><section class="page section" aria-labelledby="token-tiers-title">
        <div class="section-head">
          <h2 class="headline" id="token-tiers-title">
            {text('token.siteTiersTitle', 'What each tier unlocks')}
          </h2>
          <p class="small">
            {info.gatingOn
              ? text(
                  'token.siteUnlocksOn',
                  'Your tier follows the share of the supply your signed-in wallet holds. Prix reads the balance from the chain.',
                )
              : text(
                  'token.unlocksOff',
                  'Tiers are not switched on. Every wallet has the same access today. When they are switched on, this table says what each share of the supply unlocks.',
                )}
          </p>
        </div>
        <Table id="tiers-table" caption={text('token.tiersCaption', 'Tiers and what each unlocks')} columns={columns} scroll minWidth="40rem">
          <tbody>
            {tiers.map((rule) => (
              <tr>
                <th scope="row">{text('token.siteTierRow', 'Tier {tier}', { tier: rule.tier })}</th>
                <td class="num">{rule.tier === 0 ? text('token.siteHoldNone', 'None') : percent(rule.thresholdPpm)}</td>
                <td class="num">{whole(rule.maxAgents)}</td>
                <td>
                  {rule.realtimeFeed
                    ? text('token.siteFeedLive', 'Live')
                    : text('token.siteFeedLate', '{delay} late', { delay: formatFeedDelay(info?.feedDelaySeconds ?? 0) })}
                </td>
                <td>{rule.verifiedBadge ? yes : no}</td>
                <td class="num">{whole(rule.apiDailyQuota)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </section></div>
    )
  }

  {
    showHolders && info && amounts && (
      <section class="page section" aria-labelledby="token-holders-title" data-holders>
        <div class="section-head">
          <h2 class="headline" id="token-holders-title">{text('token.holdersTitle', 'Open to holders now')}</h2>
          <p class="small">
            {text('token.holdersIntro', 'What a wallet gets, by how much $PRIX it holds. Amounts are whole tokens.')}
          </p>
        </div>
        <HoldersTable
          tiers={info.tiers}
          feedDelaySeconds={info.feedDelaySeconds}
          picturesOn={picturesOn}
          ownerHoldsOn={ownerHoldsOn}
        />
        <ul class="token-list holders-notes" role="list">
          <li>
            {text(
              'token.holdersRiseNote',
              "A higher tier counts about an hour after Prix first sees the holding. A lower one counts at Prix's next check.",
            )}
          </li>
          <li>
            {text(
              'token.holdersLiveHeld',
              "The day's trades of an agent linked to Prix Live show at 20:00 UTC to everyone, holders included; only its owner sees them sooner.",
            )}
          </li>
          <li>{text('token.holdersLiveNothing', 'Holding $PRIX changes nothing in Prix Live.')}</li>
          <li>{badgeValue(ownerHoldsOn)}</li>
        </ul>
        <p class="holders-access">{text('token.holdersAccess', 'What $PRIX gives is access to features, never a return.')}</p>
      </section>
    )
  }

  {
    showHolders && amounts && pollNow && (
      <section class="page section" aria-labelledby="token-now-title" data-holders-now>
        <h2 class="headline" id="token-now-title">{text('token.holdersNowTitle', "The holders' poll is open")}</h2>
        <ul class="token-list holders-next" role="list">
          <li>
            {pollLine} <a href="/polls">{pollLinkLabel}</a>
          </li>
        </ul>
      </section>
    )
  }

  {
    showHolders && amounts && (
      <section class="page section" aria-labelledby="token-next-title" data-holders-next>
        <h2 class="headline" id="token-next-title">{text('token.holdersNextTitle', 'Next for holders')}</h2>
        <ul class="token-list holders-next" role="list">
          <li>
            {text(
              'token.holdersNextCoach',
              "The Strategy Coach: help with writing and sharpening your agent's strategy. Not open yet.",
            )}
          </li>
          {!pollNow && (
            <li>
              {pollLine}
              {pollLink && (
                <>
                  {' '}
                  <a href="/polls">{pollLinkLabel}</a>
                </>
              )}
            </li>
          )}
        </ul>
      </section>
    )
  }

  {
    showForehead && (
      <section class="page section" aria-labelledby="token-forehead-title">
        <div class="section-head">
          <h2 class="headline" id="token-forehead-title">
            {text('token.foreheadTitle', 'What the token unlocks in FOREHEAD')}
          </h2>
          {tiers.length > 0 && (
            <p class="small">
              {text('token.foreheadOwnAmounts', 'The game sets these amounts itself. They are not the tiers above.')}
            </p>
          )}
        </div>
        <div class="stack-16">
          <p class="prose">
            {text(
              'token.foreheadBody',
              'FOREHEAD is a browser game made by Prix’s founder, on a site of its own. You sign in there by signing a message with your wallet, and the game reads the wallet’s $PRIX, at the address above, from Robinhood Chain at most once an hour.',
            )}
          </p>
          <ul class="token-list" role="list">
            <li>
              {text(
                'token.foreheadUnlockLower',
                'A wallet with {amount} $PRIX or more: four more outfit colours and a gold outline on the name tag.',
                { amount: grouped(foreheadFacts.lowerTokens) },
              )}
            </li>
            <li>
              {text(
                'token.foreheadUnlockHigher',
                'A wallet with {amount} $PRIX or more: also three hats and a frame for the kill-cam photo.',
                { amount: grouped(foreheadFacts.higherTokens) },
              )}
            </li>
          </ul>
          <p class="small">{text('token.foreheadCosmetic', 'Cosmetic only: nothing in play changes.')}</p>
          <div>
            <Button label={text('token.foreheadLink', 'Play FOREHEAD')} href={links.forehead} variant="secondary" />
          </div>
        </div>
      </section>
    )
  }

  <section class="page section token-risks" aria-labelledby="token-risk-title">
    <h2 class="headline" id="token-risk-title">{text('token.riskTitle', 'Risks')}</h2>
    <ul class="token-list" role="list">
      <li>{text('token.riskAll', 'It can lose all of its value.')}</li>
      <li>{text('token.riskThin', 'Liquidity may be thin, so it may be hard to sell at any price, or at all.')}</li>
      <li>{text('token.riskMarket', 'Its price is set by a market that Prix does not control.')}</li>
    </ul>
    <p class="small">
      {text('token.siteDisclosureLead', 'Stock Tokens have their own risks.')}{' '}
      <a href={disclosureUrl} rel="noopener noreferrer" target="_blank">
        {text('token.siteDisclosureLink', 'Read Robinhood’s disclosure.')}
      </a>
    </p>
  </section>
</Layout>

<style>
  /*
    The panel of .with-panel spans nine rows, and the empty rows would each add a row gap under
    a page with two blocks on the left. This page has two, so its panel spans two.
  */
  @media (min-width: 60em) {
    .token-top > :global(.panel) {
      grid-row: 1 / span 2;
    }

    /* The head keeps its own height; what the panel adds below it goes to the second row. */
    .token-top {
      grid-template-rows: auto 1fr;
    }
  }

  .token-about {
    display: grid;
    gap: var(--space-24);
  }

  @media (min-width: 60em) {
    .token-about {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-32);
    }
  }

  /* A plain list of statements: reading text, one line each, no rule and no bar. */
  .token-list {
    display: grid;
    gap: var(--space-8);
    max-width: var(--measure);
    font-size: var(--text-16);
    line-height: var(--leading-16);
  }

  /* Under the holders' table: the statements, then the access line on its own, in ink. */
  .holders-notes {
    margin-top: var(--space-24);
  }

  .holders-access {
    max-width: var(--measure);
    margin-top: var(--space-16);
    font-size: var(--text-16);
    line-height: var(--leading-16);
    font-weight: 600;
  }

  .holders-next {
    margin-top: var(--space-16);
  }

  .holders-next a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .token-links {
    display: grid;
    gap: var(--space-8);
  }

  .token-links a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .token-risks {
    padding-bottom: var(--space-48);
  }

  .token-risks > * + * {
    margin-top: var(--space-16);
  }
</style>
