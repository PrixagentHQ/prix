---
// The band of the league's figures under the featured block (docs/DESIGN.md sections 5.3 and
// 10): how big the league is today. Each figure is one the API gave, or a count or a choice of
// what it gave:
//
//   Agents          the agent count of each division's standings (or its rows, on a single page)
//   Decisions       the decisions of the league feed, while the feed holds all of them; once it
//                   holds only the newest page, those of the latest round in it
//   Trades          the trade counts of every row, while both divisions fit on one page
//   Highest return  the highest return the API published, as it published it, with the agent's
//                   name, while both divisions fit on one page
//
// Nothing is worked out from a return or a score: the highest return is one of the API's
// figures, shown exactly, and a band without the whole league leaves the two last figures out.
// Prix is one continuous league (D-109), so no figure is counted per season.
import type { FeedPage, LeagueResponse, StandingRow } from '@prix/contracts';
import { formatCount, formatPercentBps } from '../../content/format.ts';
import { text } from '../../content/index.ts';
import FigureBand from '../../design/FigureBand.astro';
import { toneOf } from './board.ts';

interface Props {
  open: LeagueResponse;
  /** The Pro division's standings, or null when they could not be read. */
  pro: LeagueResponse | null;
  /** The newest page of the league feed, or null when it could not be read. */
  feed: FeedPage | null;
  /** Inside another block's column, without the page's margins and the gap of a section. */
  inline?: boolean;
}

const { open, pro, feed, inline = false } = Astro.props;

const countOf = (league: LeagueResponse): number | null =>
  league.state?.agentCount ?? (league.hasMore ? null : league.rows.length);

const items: Array<{ label: string; value: string; detail?: string; tone?: 'gain' | 'loss'; count?: boolean }> = [];

const openCount = countOf(open);
const proCount = pro ? countOf(pro) : null;
if (openCount !== null && proCount !== null) {
  items.push({
    label: text('league.figureAgents', 'Agents'),
    value: formatCount(openCount + proCount),
    detail: text('league.figureAgentsSplit', '{open} Open, {pro} Pro', {
      open: formatCount(openCount),
      pro: formatCount(proCount),
    }),
    count: true,
  });
} else if (openCount !== null) {
  items.push({ label: text('league.figureAgentsOpen', 'Agents in Open'), value: formatCount(openCount), count: true });
}

if (feed) {
  const whole = feed.nextCursor === null;
  const latestTick = feed.items[0]?.tickId;
  const latest = latestTick ? feed.items.filter((item) => item.tickId === latestTick) : [];
  // The newest page may hold only part of the latest round when every item on it is from that round.
  const latestWhole = latest.length < feed.items.length;
  const scope = whole ? feed.items : latestWhole ? latest : null;
  if (scope) {
    items.push({
      label: whole
        ? text('league.figureDecisionsAll', 'Decisions')
        : text('league.figureDecisionsRound', 'Decisions in the latest round'),
      value: formatCount(scope.length),
      count: true,
    });
  }
}

// Trades and the highest return need every agent: both divisions, each on one page.
const everyRow: StandingRow[] | null =
  pro && !open.hasMore && !pro.hasMore && open.page === 1 && pro.page === 1 ? [...open.rows, ...pro.rows] : null;
if (everyRow && everyRow.length > 0) {
  items.push({
    label: text('common.trades', 'Trades'),
    value: formatCount(everyRow.reduce((sum, row) => sum + row.tradeCount, 0)),
    count: true,
  });
  const best = everyRow.reduce((top, row) => (row.seasonReturnBps > top.seasonReturnBps ? row : top));
  items.push({
    label: text('league.figureBestReturn', 'Highest return'),
    value: formatPercentBps(best.seasonReturnBps),
    tone: toneOf(best.seasonReturnBps),
    detail: best.name,
  });
}

const label = text('league.figuresLabelLeague', 'The league in figures');
---

<div class:list={[!inline && 'page section']} data-live="figures" data-reveal hidden={items.length < 2}>
  {items.length > 1 && <FigureBand label={label} items={items} />}
</div>
