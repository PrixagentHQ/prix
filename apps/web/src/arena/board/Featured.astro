---
// The featured block that opens the home page, inside the hero zone (docs/DESIGN.md sections 5.3
// and 6): one agent large, with its line across the block and the band of the league's figures under
// it (the default slot), and the next two agents beside it as cards.
//
// Once the division is ranked, the agent is the leader, in the API's order, and the two beside it
// are the next rows in that order. Before anyone is ranked, the agents are those that decided most
// recently, in the order of the league feed, then the published order. A house agent may lead: it
// shows its House chip and one line that Prix runs it as an example and that its figures are the
// record of a simulation. Nothing is ranked or scored here. The note that a model writes the
// summaries stands once on the home page, under the board (HomePage.astro).
import type { FeedItem, LeagueResponse, StandingRow } from '@prix/contracts';
import { text } from '../../content/index.ts';
import { divisionText } from '../../content/states.ts';
import BoardCard from './BoardCard.astro';
import { cardOf, signInHere, sparkScale } from './board.ts';

interface Props {
  league: LeagueResponse;
  /** The newest decisions of the league, newest first. Empty when the feed has none or failed. */
  recent: readonly FeedItem[];
  follows: ReadonlySet<string> | null;
  followsFailed?: boolean;
}

/** How many agents stand beside the featured one. */
const SIDE_CARDS = 2;

const { league, recent, follows, followsFailed = false } = Astro.props;

const early = !league.rows.some((row) => row.rank !== null);
const byId = new Map(league.rows.map((row) => [row.agentId, row]));
// The order the block takes its agents in: the published order once ranked (ranked rows first);
// before anyone is ranked, the latest deciders first, then the published order.
const deciders = recent.map((item) => byId.get(item.agentId)).filter((row): row is StandingRow => row !== undefined);
const candidates: StandingRow[] = early
  ? [...new Set([...deciders, ...league.rows])]
  : [...league.rows.filter((row) => row.rank !== null), ...league.rows.filter((row) => row.rank === null)];
const [lead, ...rest] = candidates;
const side = rest.slice(0, SIDE_CARDS);

const scale = sparkScale(league.rows);
const division = divisionText(league.division);
const eyebrow = early
  ? lead && deciders.includes(lead)
    ? text('league.featuredRecent', 'Decided most recently')
    : text('league.featuredDivision', 'From the {division} division', { division })
  : text('league.featuredLeader', 'Leading the {division} division', { division });

const signIn = signInHere(Astro.url);
---

<div data-live="featured">
  {
    lead ? (
      <section class="page section featured" aria-labelledby="featured-title">
        <h2 class="visually-hidden" id="featured-title">
          {text('league.featuredTitle', 'Featured agents')}
        </h2>
        <div class:list={['featured-grid', side.length > 0 && 'has-side']}>
          <div class="featured-main">
            <BoardCard
              card={cardOf(lead, league, scale, Astro.url)}
              featured={{ eyebrow, tradingDays: lead.tradingDays }}
              follows={follows}
              followsFailed={followsFailed}
              signIn={signIn}
            />
            <slot />
          </div>
          {side.length > 0 && (
            <div class="featured-side">
              {side.map((row) => (
                <BoardCard
                  card={cardOf(row, league, scale, Astro.url)}
                  follows={follows}
                  followsFailed={followsFailed}
                  signIn={signIn}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    ) : (
      <div class="page section">
        <slot />
      </div>
    )
  }
</div>

<style>
  /* Under the league strip, closer than the gap between two blocks. */
  .featured {
    margin-top: var(--space-24);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-card);
  }

  /* The featured agent, and under it the band of the league's figures. */
  .featured-main {
    display: grid;
    align-content: start;
    gap: var(--space-24);
    min-width: 0;
  }

  /*
    Below 960 pixels the featured line is the size of a card's line, 120 by 40, at the right end of
    the row of its label, straight under the figure. A plot as wide as the card would leave the
    shared scale's empty band between the figure and its line.
  */
  @media (max-width: 59.9375em) {
    .featured-main :global(.agent-card--featured .agent-card-label) {
      align-self: start;
    }

    .featured-main :global(.agent-card--featured .agent-card-spark) {
      grid-area: 6 / 1 / 7 / -1;
      justify-self: end;
      align-self: start;
      margin-top: 0;
    }

    .featured-main :global(.agent-card--featured .spark) {
      width: 7.5rem;
      max-height: none;
    }
  }

  /* The two beside it: one column on a phone, two from 560, one column beside the featured card. */
  .featured-side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--gap-card);
    min-width: 0;
  }

  @media (min-width: 35em) {
    .featured-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68.75em) {
    .featured-grid.has-side {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .featured-side {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
