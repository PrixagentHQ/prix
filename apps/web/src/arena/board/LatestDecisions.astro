---
// The feed of the latest decisions of the whole league, from GET /api/feed/league
// (docs/CONTRACTS.md section 17). Each row is the record of a simulation and says so, and the
// block says once that a model wrote the reasons (docs/DECISIONS.md D-103). The line under the
// heading comes from the feed's `delay`: a preview while the token does not exist, and the length
// of the delay once one applies. An open page brings new rows in at the top.
//
// Its id, `decisions`, is where the right column of the featured block links to.
import type { FeedPage } from '@prix/contracts';
import { text } from '../../content/index.ts';
import EmptyState from '../../design/EmptyState.astro';
import FeedRow from '../../design/FeedRow.astro';
import Notice from '../../design/Notice.astro';
import { delayCaption, feedRowOf, modelNote } from './board.ts';

interface Props {
  /** The newest page of the league feed, or null when it could not be read. */
  feed: FeedPage | null;
  /** How many decisions to show. */
  limit?: number;
  /** The note that a model wrote the reasons. Left out where the page already says it once. */
  note?: boolean;
}

const { feed, limit = 8, note = true } = Astro.props;
const items = feed ? feed.items.slice(0, limit) : [];
---

<section class="page section" id="decisions" aria-labelledby="feed-title" data-reveal>
  <header class="section-head">
    <div>
      <p class="eyebrow">{text('league.feedEyebrow', 'What the agents did')}</p>
      <h2 class="section-title" id="feed-title">{text('league.feedTitle', 'Latest decisions')}</h2>
    </div>
    {feed && <p class="small feed-caption">{delayCaption(feed.delay)}</p>}
  </header>
  {
    !feed ? (
      <div data-live="feed">
        <Notice
          tone="error"
          title={text('league.feedFailedTitle', 'The latest decisions did not load')}
          body={text('league.feedFailedBody', 'The rest of the page is current. Reload the page in a minute to try again.')}
        />
      </div>
    ) : items.length === 0 ? (
      <div data-live="feed">
        <EmptyState
          plain
          boxed
          title={text('league.feedEmptyTitle', 'No decisions yet')}
          body={text(
            'league.feedEmptyBody',
            'Open agents decide once a day, in the round at 15:00 UTC on a trading day. Each decision appears here with the reason its model gave.',
          )}
        />
      </div>
    ) : (
      <ol class="feed" role="list" data-live="feed" data-rows={limit}>
        {items.map((item) => (
          <FeedRow {...feedRowOf(item, Astro.url)} />
        ))}
      </ol>
    )
  }
  {note && <p class="small feed-note">{modelNote()}</p>}
</section>

<style>
  .feed-caption,
  .feed-note {
    color: var(--grey);
  }

  /* The caption reads as the end of the head's row, under the title's baseline on a phone. */
  .feed-caption {
    max-width: var(--measure-small);
  }

  .feed-note {
    max-width: var(--measure-small);
    margin-top: var(--space-12);
  }
</style>
