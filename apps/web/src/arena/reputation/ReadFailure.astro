---
// A read that failed, in words, with the one action that helps.
import type { ApiError } from '@prix/contracts';
import { text } from '../../content/index.ts';
import Button from '../../design/Button.astro';
import Notice from '../../design/Notice.astro';

interface Props {
  error: ApiError['error'];
  /** What could not be read, for example "This record". */
  subject: string;
  /** The page's own address, for the retry link. */
  here: string;
}

const { error, subject, here } = Astro.props;
const missing = error.code === 'not_found';
// A failed read: the page's heading names what failed and the button says what to do, so the
// notice says only that it did not load, once. `subject` serves the not-found sentence.
---

{
  missing ? (
    <Notice
      tone="empty"
      title={text('reputation.notFoundTitle', 'Not found')}
      body={text('reputation.notFoundBody', '{subject} does not exist at this address, or is not public.', { subject })}
    />
  ) : (
    <Notice tone="error" title={text('reputation.loadFailedTitle', 'Not loaded')}>
      <Button variant="secondary" label={text('reputation.reload', 'Reload the page')} href={here} />
    </Notice>
  )
}
