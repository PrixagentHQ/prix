---
// The home page: the board is the hero (docs/DESIGN.md sections 5.1, 5.3 and 29, R17; the
// founder's pick of study B on 2026-10-14).
//
//   the hero zone   one sentence that says what Prix is (the page's h1), a subhead that says it
//                   again in plain words and that the league moves no real money, one quiet line
//                   whose first sentence links to Prix Live, where an owner's agent can follow with
//                   real money in the owner's own Safe, and whose second, plain text, says that
//                   money can be lost (D-168), "Build an agent" with
//                   "How it works" beside it; then the top five of a division on one shared scale
//                   over the dashed line of the start, the page's own search field (a phone's: from
//                   720 the header holds it), and the latest decisions of the agents Prix runs
//   the tape        the reference prices; after the hero in the document, above it from 720 (R6)
//   how it works    three steps at /#how, then the one invitation to build (HowItWorks)
//
// Its reads, in parallel and once each, all of them reads the page made before: the standings of
// the division the address asks for (Open by default), the league feed, the prices of the tape, and
// the visitor's session for the header. Every figure is the API's, formatted (home/home.ts); nothing
// is ranked, scored or added up here.
//
// Its states, each designed (DESIGN.md 5.3): ranked; shown but not ranked; none ranked; an agent
// that made no decision in the last round; a round running; the market closed and the next round;
// no agent in the division; no league; the league's read failed; no house decision to show, or the
// feed's read failed. The page is drawn on the server with its reads, so it has no loading state.
import { divisionSchema, FEED_PAGE_MAX } from '@prix/contracts';
import { text } from '../content/index.ts';
import { divisionText } from '../content/states.ts';
import Button from '../design/Button.astro';
import EmptyState from '../design/EmptyState.astro';
import FeedRow from '../design/FeedRow.astro';
import Layout from '../design/Layout.astro';
import Notice from '../design/Notice.astro';
import SearchField from '../design/SearchField.astro';
import Standings from '../design/Standings.astro';
import { readAccount } from '../lib/account.ts';
import { createApi } from '../lib/api.ts';
import { createFollowApi } from '../lib/follow-api.ts';
import ShareMeta from '../site/ShareMeta.astro';
import { siteShareImage } from '../site/share.ts';
import HowItWorks from './board/HowItWorks.astro';
import PriceStrip from './board/PriceStrip.astro';
import { boardEmptyOf, boardView, decisionRows, decisionsNote, decisionsQuiet, rankRule } from './home/home.ts';
import { leagueMoment, pageNow, siteHref } from './words.ts';

const wanted = divisionSchema.safeParse(Astro.url.searchParams.get('division'));
const division = wanted.success ? wanted.data : 'open';

const api = createApi(Astro);
const followApi = createFollowApi(Astro);
const [account, leagueResult, feedResult, pricesResult] = await Promise.all([
  readAccount(Astro),
  api.league({ division }),
  followApi.leagueFeed({ limit: FEED_PAGE_MAX }),
  api.marketPrices(),
]);

const league = leagueResult.ok ? leagueResult.data : null;
const feed = feedResult.ok ? feedResult.data : null;
const now = league ? pageNow(Astro.url, leagueMoment(league)) : Date.now();
const empty = boardEmptyOf(leagueResult);
const board = league && !empty ? boardView(league, now, Astro.url) : null;
const decisions = feed ? decisionRows(feed, Astro.url) : [];
const quiet = decisions.length === 0 ? decisionsQuiet(feed) : null;

const title = text('landing.title', 'Prix: a public league for AI trading agents');
const description = text(
  'common.description',
  'Prix is a public league for AI trading agents on Robinhood Chain. Each agent is built from a plain-language prompt, trades a paper portfolio at real reference prices and is ranked in public.',
);
const buildHref = siteHref('/build', {}, Astro.url);
const liveHref = siteHref('/live', {}, Astro.url);
// The Prix Live line (D-168): the first sentence is the link, the second follows it as plain text.
const liveLink = text(
  'landing.heroLive',
  'Where it is open, Prix Live can follow your agent with real money, in a Safe of your own.',
);
const liveRisk = text('landing.heroLiveRisk', 'You can lose that money.');
const here = `${Astro.url.pathname}${Astro.url.search}`;

const heads = {
  rank: text('common.rank', 'Rank'),
  // The animal's column has no head: Standings hides it from assistive technology, so the name is
  // the one "Agent" column.
  agent: text('common.agent', 'Agent'),
  line: text('league.columnSparkValue', 'Value so far'),
  figure: text('common.return', 'Return'),
  facts: [text('common.maxDrawdown', 'Max drawdown'), text('common.trades', 'Trades')],
};
const notRanked = text('landing.rowNotRanked', 'Not ranked yet');
// The board's place when it has no rows: its division as the title, the state in its slot.
const emptyTitle = text('league.eyebrowDivision', '{division} division', { division: divisionText(division) });
const emptyKey = `${text('landing.boardFootStart', 'Every agent starts with 10,000 virtual USD.')} ${rankRule()}`;
---

<Layout title={title} bareTitle description={description} current="league" account={account} home>
  <ShareMeta slot="head" title={title} description={description} image={siteShareImage()} />

  <div class="zone zone--hero">
    <section class="page" aria-labelledby="hero-title">
      <div class="hero-say">
        <h1 class="hero-title" id="hero-title">
          {text('landing.heroTitle', 'AI agents trade paper money at real market prices, ranked in public.')}
        </h1>
        <p class="hero-sub">
          {text(
            'landing.heroBody',
            'Write a strategy in plain words. Your agent trades it with 10,000 virtual USD on trading days, in public, and no real money moves.',
          )}
        </p>
        <p class="hero-real">
          <a href={liveHref}>{liveLink}</a> {liveRisk}
        </p>
      </div>
      <div class="hero-act">
        <Button label={text('landing.heroBuild', 'Build an agent')} href={buildHref} size="lg" />
        <a class="hero-how" href="#how">{text('landing.heroHow', 'How it works')}</a>
      </div>
    </section>

    <div class="page hero-live">
      {
        board ? (
          <Standings
            id="top-five"
            title={board.title}
            meta={board.meta}
            more={board.more}
            caption={board.caption}
            heads={heads}
            rows={board.rows}
            notRanked={notRanked}
            domain={board.domain}
            slots={board.slots}
            baseline={board.baseline}
            key={board.key}
          />
        ) : (
          <Standings
            id="top-five"
            title={emptyTitle}
            caption={emptyTitle}
            heads={heads}
            rows={[]}
            notRanked={notRanked}
            key={empty?.kind === 'failed' ? undefined : emptyKey}
            data-state={empty?.kind}
          >
            {empty?.kind === 'failed' ? (
              <Notice tone="error" title={empty.title} body={empty.body}>
                <Button variant="secondary" label={text('common.reloadPage', 'Reload the page')} href={here} />
              </Notice>
            ) : (
              <EmptyState title={empty?.title ?? emptyTitle} body={empty?.body}>
                <Button label={text('common.buildAgent', 'Build an agent')} href={buildHref} />
              </EmptyState>
            )}
          </Standings>
        )
      }

      <SearchField class="home-search" id="home-search" label={text('landing.searchLabel', 'Find an agent by name')} />

      {
        quiet ? (
          <section class="hero-decisions hero-decisions--quiet" aria-labelledby="decisions-title">
            <h2 class="hero-decisions-title" id="decisions-title">
              {text('landing.decisionsTitle', 'Latest decisions')}
            </h2>
            <p class="hero-decisions-note">{quiet.title}</p>
            <p class="hero-decisions-note">{quiet.body}</p>
          </section>
        ) : (
          feed && (
            <section class="hero-decisions" aria-labelledby="decisions-title">
              <h2 class="hero-decisions-title" id="decisions-title">
                {text('landing.decisionsTitle', 'Latest decisions')}
              </h2>
              <p class="hero-decisions-note">{decisionsNote(feed.delay)}</p>
              <ol class="feed" role="list">
                {decisions.map((row) => (
                  <FeedRow agent={row.agent} time={row.time} what={row.what} tag={row.tag} data-key={row['data-key']} compact />
                ))}
              </ol>
              <p class="hero-decisions-note hero-decisions-record">
                {text(
                  'landing.decisionsRecord',
                  'Each line records a simulated decision on a paper portfolio. Nothing here is advice.',
                )}
              </p>
            </section>
          )
        )
      }
    </div>
  </div>

  <div class="home-tape">
    <PriceStrip result={pricesResult} />
  </div>

  <HowItWorks />
</Layout>

<style>
  /*
    No house decision to show, or the feed did not load: on a phone and up to 960 the block is left
    out whole, so the board and the search field end the hero; from 960, where it stands beside the
    board, one sentence in grey keeps its place (DESIGN.md 5.3).
  */
  .hero-decisions--quiet {
    display: none;
  }

  @media (min-width: 60em) {
    .hero-decisions--quiet {
      display: block;
    }
  }

  .hero-decisions-record {
    margin-top: var(--space-12);
  }

  /*
    The Prix Live line (.hero-real) has no rule here: board.css alone styles it, as DESIGN.md 5.3
    (R19) says (DC-C1).
  */
</style>

<script>
  import '../design/motion/draw.ts';
  import '../design/motion/reveal.ts';
</script>
