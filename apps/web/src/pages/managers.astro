---
import { fetchManagers, pageOf, statusOf } from '../arena/social/client.ts';
import ManagersPage from '../arena/social/ManagersPage.astro';

// The status is the API's: with the switch off the route answers 404, and so does this page.
const result = await fetchManagers(Astro, pageOf(Astro.url));
if (!result.ok && result.status === 404) return Astro.rewrite('/404');
Astro.response.status = statusOf(result);
---

<ManagersPage />
