---
import { idSchema } from '@prix/contracts';
import { fetchManager, statusOf } from '../../arena/social/client.ts';
import ManagerPage from '../../arena/social/ManagerPage.astro';

// An address that cannot be a paper manager costs no API call. The API's 404 (unknown, hidden,
// or the switch off) is this page's 404, and any other failure is sent with its own status.
const id = Astro.params.id ?? '';
if (!idSchema.safeParse(id).success) return Astro.rewrite('/404');
const result = await fetchManager(Astro, id);
if (!result.ok && result.status === 404) return Astro.rewrite('/404');
Astro.response.status = statusOf(result);
---

<ManagerPage />
