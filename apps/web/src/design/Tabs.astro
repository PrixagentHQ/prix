---
// A row of links that switch between views of one page, such as the two divisions.
// Each tab is a real link, so it works without script. The selected tab is `aria-current`.
// With script, the arrow keys move between tabs and focus stays on the tab just used.
interface Props {
  /** The name of the group for assistive technology, for example "Division". */
  label: string;
  /** Unique on the page. Focus is restored by it after the page reloads. */
  id: string;
  items: Array<{ label: string; href: string; current?: boolean }>;
}

const { label, id, items } = Astro.props;
---

<nav class="tabs" aria-label={label} data-tabs={id}>
  <ul class="tabs-list" role="list">
    {
      items.map((item, index) => (
        <li>
          <a href={item.href} id={`${id}-${index}`} aria-current={item.current ? 'true' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const KEY = 'prix-tab';

  // After a tab reloads the page, put focus back on the tab that was used.
  try {
    const last = sessionStorage.getItem(KEY);
    if (last) {
      sessionStorage.removeItem(KEY);
      document.getElementById(last)?.focus({ preventScroll: true });
    }
  } catch {
    // Storage is blocked. Tabs still work; focus starts at the top of the page.
  }

  for (const group of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...group.querySelectorAll<HTMLAnchorElement>('a')];
    group.addEventListener('keydown', (event) => {
      const at = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (at < 0) return;
      let next = at;
      if (event.key === 'ArrowRight') next = (at + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (at - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else if (event.key === ' ') {
        event.preventDefault();
        tabs[at]?.click();
        return;
      } else return;
      event.preventDefault();
      tabs[next]?.focus();
    });
    group.addEventListener('click', (event) => {
      const tab = (event.target as Element).closest('a');
      if (!tab?.id) return;
      try {
        sessionStorage.setItem(KEY, tab.id);
      } catch {
        // Storage is blocked. Nothing to remember.
      }
    });
  }
</script>
