<script>
  // The motion modules a page imports, and what a page writes to use the ones that are functions.
  import './motion/carry.ts';
  import './motion/count.ts';
  import './motion/countdown.ts';
  import './motion/draw.ts';
  import { arrive } from './motion/feed.ts';
  import './motion/reveal.ts';
  import { toast } from './motion/toast.ts';
  import { switchBoard } from './reorder.ts';

  for (const group of document.querySelectorAll<HTMLElement>('[data-demo-follow]')) {
    group.addEventListener('click', (event) => {
      const button = (event.target as Element).closest('button.follow-button');
      if (!button) return;
      const on = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', on ? 'true' : 'false');
      toast(`${on ? 'Following' : 'Unfollowed'} ${(button.getAttribute('aria-label') ?? '').replace('Follow ', '')}`);
    });
  }

  for (const tabs of document.querySelectorAll<HTMLElement>('[data-demo-switch]')) {
    const board = document.getElementById(tabs.dataset.demoSwitch ?? '');
    tabs.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('button');
      if (!button || !board) return;
      for (const other of tabs.querySelectorAll('button')) {
        other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
      }
      switchBoard(board, button.dataset.value === 'list' ? 'list' : 'cards');
    });
  }

  document.querySelector<HTMLElement>('[data-demo-toast]')?.addEventListener('click', (event) => {
    toast((event.currentTarget as HTMLElement).dataset.demoToast ?? '');
  });

  const arriveButton = document.querySelector<HTMLElement>('[data-demo-arrive]');
  arriveButton?.addEventListener('click', () => {
    const list = document.getElementById(arriveButton.dataset.demoArrive ?? '');
    const last = list?.lastElementChild;
    if (list instanceof HTMLElement && last instanceof HTMLElement) arrive(list, last);
  });
</script>

