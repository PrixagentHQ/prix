---
// The specimen: every primitive in every state, with sample data that says so.
// It is not a page of the site and has no route. To see it:
//
//   node apps/web/src/design/specimen/export.mjs --serve 8600
//
// writes static pages to .artifacts/specimen/ and serves them. docs/DESIGN.md section 14 says
// how to screenshot them.
//
//   view="primitives"    the tokens and every primitive in every state (the default)
//   view="home"          the home page as the system draws it: tape, hero band, zones
//   theme="light"        any view in the light theme (dark is the default)
//   view="landing"       a page of direction A, standing on the new primitives without a change
//   view="agent"         the same for the agent's page
//   view="agent-stress"  the agent's page with the longest content the product allows
import Address from './Address.astro';
import AgentCard from './AgentCard.astro';
import AgentMark from './AgentMark.astro';
import { SPECIES } from './ascii/animal.ts';
import { agentAvatar } from './ascii/avatar.ts';
import BoardList from './BoardList.astro';
import Button from './Button.astro';
import CardGrid from './CardGrid.astro';
import Chart from './Chart.astro';
import Chip from './Chip.astro';
import Choice from './Choice.astro';
import Choices from './Choices.astro';
import Code from './Code.astro';
import CopyButton from './CopyButton.astro';
import Countdown from './Countdown.astro';
import { sparkDomain, sparkSlots } from './chart.ts';
import DefinitionList from './DefinitionList.astro';
import EmptyState from './EmptyState.astro';
import EquityCurve from './EquityCurve.astro';
import FeedRow from './FeedRow.astro';
import FigureBand from './FigureBand.astro';
import FollowButton from './FollowButton.astro';
import Layout from './Layout.astro';
import Medal from './Medal.astro';
import Meter from './Meter.astro';
import Notice from './Notice.astro';
import Panel from './Panel.astro';
import PillTabs from './PillTabs.astro';
import PrixMark from './PrixMark.astro';
import SeasonBanner from './SeasonBanner.astro';
import Select from './Select.astro';
import Skeleton from './Skeleton.astro';
import Sparkline from './Sparkline.astro';
import StatRow from './StatRow.astro';
import Steps from './Steps.astro';
import {
  chartPoints,
  earlyAgents,
  feedItems,
  holdingsOf,
  rankedAgents,
  type SampleAgent,
  sampleHoldings,
  sampleStart,
  sampleTick,
  tickerItems,
} from './specimen/board-data.ts';
import { curveDays, leagueFacts, ranked, steps, unranked } from './specimen/data.ts';
import SampleAgentPage from './specimen/SampleAgent.astro';
import SampleHome from './specimen/SampleHome.astro';
import SampleLanding from './specimen/SampleLanding.astro';
import SampleLeague from './specimen/SampleLeague.astro';
import Table from './Table.astro';
import Tabs from './Tabs.astro';
import Textarea from './Textarea.astro';
import TextInput from './TextInput.astro';
import TickerStrip from './TickerStrip.astro';
import Toast from './Toast.astro';

interface Props {
  view?: 'primitives' | 'home' | 'landing' | 'agent' | 'agent-stress';
  theme?: 'dark' | 'light';
}

const { view = 'primitives', theme = 'dark' } = Astro.props;

// The palette of both themes: the token, its value in dark (the default) and in light, its job.
const colours = [
  { name: 'Ground', token: 'ground', dark: '#000000', light: '#F2F4F7', use: 'The page.' },
  { name: 'Raised', token: 'raised', dark: '#000000', light: '#FFFFFF', use: 'A full-bleed band and the hero.' },
  { name: 'Card', token: 'card', dark: '#0A0B0D', light: '#FFFFFF', use: 'A card and a panel.' },
  { name: 'Card high', token: 'card-high', dark: '#000000', light: '#FFFFFF', use: 'A key, ringed.' },
  { name: 'Ink', token: 'ink', dark: '#F3F4F6', light: '#23272D', use: 'Text, and what is chosen.' },
  { name: 'Grey', token: 'grey', dark: '#9AA1AC', light: '#626971', use: 'Words that step back; the edge of a field.' },
  { name: 'Line', token: 'line', dark: '#262A31', light: '#E3E6EA', use: 'A hairline between two things of one kind.' },
  {
    name: 'Blue',
    token: 'blue',
    dark: '#4C8DFF',
    light: '#1452F0',
    use: 'Where Prix asks you to act: a link, focus, the tint of a state.',
  },
  {
    name: 'Blue fill',
    token: 'blue-fill',
    dark: '#2A66E0',
    light: '#1452F0',
    use: 'A primary action, and the mark of Prix.',
  },
  { name: 'Green', token: 'green', dark: '#22C55E', light: '#007A25', use: 'A figure with a plus sign, and its line.' },
  { name: 'Red', token: 'red', dark: '#F2594E', light: '#D20B0F', use: 'A figure with a minus sign, and its line.' },
  {
    name: 'Wash',
    token: 'wash',
    dark: 'white at 6%',
    light: 'ink at 5%',
    use: 'A place that is not a card: a field, a banner.',
  },
  { name: 'Tint', token: 'tint', dark: 'blue at 12%', light: 'blue at 10%', use: 'A state you turned on: Following.' },
];
const medals = [
  { name: 'Gold', token: 'gold', dark: '#F2C33D', light: '#F2C33D', use: 'Rank one.' },
  { name: 'Silver', token: 'silver', dark: '#C9CED6', light: '#C9CED6', use: 'Rank two.' },
  { name: 'Bronze', token: 'bronze', dark: '#DC9A66', light: '#DC9A66', use: 'Rank three.' },
];
const sizes = [
  { name: 'Figure 56, the hero', cls: 'figure-56', sample: '+9.84%' },
  { name: 'Section title 32', cls: 'section-title', sample: 'Top agents' },
  { name: 'Eyebrow 13', cls: 'eyebrow', sample: 'Season 2, sample data' },
  { name: 'Figure 40', cls: 'figure-40', sample: '+9.84%' },
  { name: 'Figure 28', cls: 'figure-28', sample: '+9.84%' },
  { name: 'Display 24', cls: 'display', sample: 'Semis Rotation' },
  { name: 'Headline 20', cls: 'headline', sample: 'Top agents' },
  { name: 'Title 16', cls: 'title', sample: 'Holdings' },
  { name: 'Prose 16', cls: 'prose', sample: 'Rotates between NVDA, AMD, MU and INTC on relative strength.' },
  {
    name: 'Body 14',
    cls: 'body',
    sample: 'Following puts this agent’s decisions in your feed. Nothing is traded for you.',
  },
  { name: 'Small 13', cls: 'small', sample: 'The paper portfolio after the last round, at reference prices.' },
  { name: 'Caption 12', cls: 'caption', sample: 'Season return' },
];
const spaces = [2, 4, 6, 8, 12, 16, 24, 32, 48, 64, 96];
const markIds = [
  'k2m9x4q7w1zt',
  'p7c3n8v5b2ya',
  '4nxdlbu3idgu',
  'h5t1r9e6s3df',
  'w8g2j6l4m0pq',
  'z1a5o9i3u7ye',
  'b6v0c4x8z2nm',
  'q3f7d1s5a9gh',
  'm4k8t2w6r0pa',
  'y9e3u7i1o5sd',
  'f2h6j0l4z8xc',
  'c8s2e6n0t4vb',
  'r1d5g9k3p7lw',
  'u0y4q8a2j6hx',
  'e7i1m5b9f3zo',
  'n3w7c1t5v9ks',
  'x6l0r4h8d2ga',
  'j9p3z7u1s5me',
];

// One sample id for each of the twelve animals: the first id of a fixed run that draws it.
const animalIds: string[] = [];
for (let index = 0; animalIds.length < SPECIES.length && index < 2000; index += 1) {
  const id = `sample${index.toString(36).padStart(6, '0')}`;
  const species = agentAvatar(id).species;
  if (!animalIds.some((known) => agentAvatar(known).species === species)) animalIds.push(id);
}
// The nine house agents of the fixture league-early, by the ids the fixtures give them.
const boardIdOf = (name: string) =>
  name
    .toLowerCase()
    .replace(/[^a-z2-7]/g, '')
    .padEnd(12, 'a')
    .slice(0, 12);
const todaysBoard = [
  'Index Core',
  'Semis Rotation',
  'Treasury First',
  'Dip Buyer',
  'Momentum Five',
  'Oil And Idle',
  'Big Tech Equal',
  'Crypto Proxies',
  'Crowd Favourites',
].map((name) => ({ name, id: boardIdOf(name) }));

const domainOf = (agents: SampleAgent[]) => sparkDomain(agents.map((agent) => agent.values));
const slotsOf = (agents: SampleAgent[]) => sparkSlots(agents.map((agent) => agent.values));
const rankedDomain = domainOf(rankedAgents);
const rankedSlots = slotsOf(rankedAgents);
const earlySlots = slotsOf(earlyAgents);

const cardOf = (agent: SampleAgent, slots: number, domain?: readonly [number, number]) => ({
  href: `#agent-${agent.id}`,
  agentId: agent.id,
  name: agent.name,
  rank:
    agent.rank === null
      ? { text: 'Not ranked', unranked: true }
      : agent.rank <= 3
        ? { text: `#${agent.rank}`, place: agent.rank as 1 | 2 | 3, label: `Rank ${agent.rank}` }
        : { text: `#${agent.rank}` },
  chips: [
    { label: agent.division, kind: agent.division === 'Pro' ? ('pro' as const) : ('open' as const) },
    ...(agent.house ? [{ label: 'House', kind: 'house' as const }] : []),
  ],
  summary: agent.summary,
  figure: { value: agent.ret, label: 'Season return', tone: agent.tone },
  spark: {
    values: agent.values,
    domain,
    slots,
    baseline: sampleStart,
    label: `Portfolio value from 10,000.00 to ${(agent.values.at(-1) ?? sampleStart).toFixed(2)} virtual USD`,
    emptyLabel: 'No trading days yet',
  },
  facts: [
    { label: 'Max drawdown', value: agent.drawdown },
    { label: 'Trades', value: agent.trades },
  ],
  holdings: holdingsOf[agent.name]?.holdings,
  cash: holdingsOf[agent.name] ? { label: 'Cash', weight: holdingsOf[agent.name]?.cash ?? '' } : undefined,
  holdingsLabel: 'Largest holdings',
});
const heads = {
  rank: 'Rank',
  agent: 'Agent',
  figure: 'Season return',
  line: 'Portfolio value',
  facts: ['Max drawdown', 'Trades'],
};
const leader = rankedAgents[0];
---

<Layout
  title="Specimen"
  description="Every primitive of the Prix design system, with sample data."
  current={view === 'primitives' ? null : 'league'}
  account={view === 'agent' ? { short: '0x7a3f…c91e' } : null}
  noindex
  theme={theme}
>
  {view === 'home' && <SampleHome />}
  {view === 'landing' && <SampleLanding />}
  {view === 'agent' && <SampleAgentPage />}
  {view === 'agent-stress' && <SampleAgentPage stress />}
  {
    view === 'primitives' && (
      <div class="page specimen">
        <header class="section">
          <h1 class="display">Specimen</h1>
          <p class="small">
            <strong>Sample data.</strong> Every name and figure on this page is invented to show the primitives.
          </p>
        </header>

        <section class="section" aria-labelledby="s-colour">
          <div class="section-head">
            <h2 class="title" id="s-colour">
              Colour
            </h2>
          </div>
          <ul class="swatches" role="list">
            {[...colours, ...medals].map((colour) => (
              <li>
                <span class={`swatch sw-${colour.token}`} />
                <span>
                  <strong>{colour.name}</strong>{' '}
                  <span class="figures">
                    {theme === 'dark' ? colour.dark : colour.light}
                  </span>
                  <span class="facts-detail figures">
                    Dark {colour.dark}, light {colour.light}
                  </span>
                  <span class="facts-detail">{colour.use}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>

        <section class="section" aria-labelledby="s-type">
          <div class="section-head">
            <h2 class="title" id="s-type">
              Type
            </h2>
          </div>
          <dl class="types">
            {sizes.map((size) => (
              <>
                <dt class="caption">{size.name}</dt>
                <dd class={size.cls}>{size.sample}</dd>
              </>
            ))}
          </dl>
        </section>

        <section class="section" aria-labelledby="s-space">
          <div class="section-head">
            <h2 class="title" id="s-space">
              Space, radius, shadow
            </h2>
          </div>
          <ul class="spaces" role="list">
            {spaces.map((space) => (
              <li>
                <span class="figures caption">{space}</span>
                <span class={`space-bar sp-${space}`} />
              </li>
            ))}
          </ul>
          <div class="cluster shapes">
            <div class="card shape">Card at rest, 15</div>
            <div class="card card--link shape" tabindex="0">
              Card under the pointer lifts
            </div>
            <div class="panel shape">Panel, lifted</div>
            <div class="shape shape-box">Box, 12</div>
            <div class="shape shape-control">Control, 10</div>
            <div class="shape shape-pill">Pill, 6</div>
          </div>
        </section>

        <section class="section" aria-labelledby="s-marks">
          <div class="section-head">
            <h2 class="title" id="s-marks">
              Marks, medals, chips
            </h2>
          </div>
          <div class="stack-16">
            <div class="cluster">
              <PrixMark label="Prix" class="specimen-mark-lg" />
              <span class="wordmark">
                <PrixMark />
                <span>Prix</span>
              </span>
            </div>
            <div class="cluster">
              {markIds.map((id, index) => (
                <AgentMark agentId={id} name={rankedAgents[index % rankedAgents.length]?.name ?? 'Sample'} />
              ))}
            </div>
            <div class="grounds">
              <h3 class="caption">Sample data. Twelve animals in the ink and greys of the theme, and a mark without an id</h3>
              <ul class="ground-row" role="list">
                {animalIds.map((id) => (
                  <li>
                    <AgentMark agentId={id} name="Sample" size="lg" />
                    <span class="small">{agentAvatar(id).species}</span>
                  </li>
                ))}
                <li>
                  <AgentMark agentId="" name="Semis Rotation" size="lg" />
                  <span class="small">Initials, no id</span>
                </li>
              </ul>
              <h3 class="caption">The nine house agents of league-early</h3>
              <ul class="ground-board" role="list">
                {todaysBoard.map((agent) => (
                  <li>
                    <AgentMark agentId={agent.id} name={agent.name} />
                    <span class="small">{agent.name}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="cluster">
              <AgentMark agentId="k2m9x4q7w1zt" name="Semis Rotation" size="xl" />
              <AgentMark agentId="k2m9x4q7w1zt" name="Semis Rotation" size="lg" />
              <AgentMark agentId="k2m9x4q7w1zt" name="Semis Rotation" />
              <AgentMark agentId="k2m9x4q7w1zt" name="Semis Rotation" size="sm" />
            </div>
            <div class="cluster">
              <Medal rank={1} label="Rank 1" />
              <Medal rank={2} label="Rank 2" />
              <Medal rank={3} label="Rank 3" />
              <Medal rank={1} label="Rank 1" size="lg" />
              <span class="agent-card-rank">#4</span>
              <span class="agent-card-rank is-unranked">Not ranked</span>
            </div>
            <div class="cluster">
              <Chip label="Open" kind="open" />
              <Chip label="Pro" kind="pro" />
              <Chip label="House" kind="house" />
              <Chip label="Simulation record" />
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="s-button">
          <div class="section-head">
            <h2 class="title" id="s-button">
              Buttons
            </h2>
          </div>
          <div class="stack-16">
            <div class="cluster">
              <Button label="Build an agent" href="#build" size="sm" />
              <Button label="Sign in" variant="secondary" size="sm" />
              <Button label="How it works" variant="quiet" size="sm" />
            </div>
            <div class="cluster">
              <Button label="Build an agent" href="#build" />
              <Button label="Save key" type="submit" />
              <Button label="Build an agent" busyLabel="Building the agent" busy />
              <Button label="Build an agent" disabled />
            </div>
            <div class="cluster">
              <Button label="Cancel" variant="secondary" />
              <Button label="Delete key" variant="secondary" busyLabel="Deleting the key" busy />
              <Button label="Sign out" variant="quiet" />
              <Button label="Publish the prompt" variant="quiet" disabled />
            </div>
            <div class="specimen-narrow stack-8">
              <Button label="Build your own agent" size="lg" wide />
              <Button label="Copy link" variant="secondary" size="lg" wide />
            </div>
            <div class="cluster" data-demo-follow>
              <FollowButton label="Follow" pressedLabel="Following" name="Follow Semis Rotation" />
              <FollowButton label="Follow" pressedLabel="Following" name="Follow Earnings Drift" pressed />
              <FollowButton label="Follow" pressedLabel="Following" name="Follow Index Core" form="icon" />
              <FollowButton label="Follow" pressedLabel="Following" name="Follow Dip Buyer 9000" form="icon" pressed />
              <FollowButton label="Follow" pressedLabel="Following" name="Follow T-Bill Tortoise" href="#sign-in" />
            </div>
            <div class="specimen-narrow stack-8" data-demo-follow>
              <FollowButton label="Follow this agent" pressedLabel="Following" name="Follow Semis Rotation" form="action" />
              <FollowButton
                label="Follow this agent"
                pressedLabel="Following"
                name="Follow Earnings Drift"
                form="action"
                pressed
              />
            </div>
            <div class="cluster">
              <PillTabs
                label="View"
                iconsOnly
                items={[
                  { label: 'Cards', value: 'cards', icon: 'cards', current: true },
                  { label: 'Table', value: 'list', icon: 'rows' },
                ]}
              />
              <PillTabs
                label="Order"
                items={[
                  { label: 'Top', href: '#top', current: true },
                  { label: 'New', href: '#new' },
                ]}
              />
              <PillTabs
                label="Range"
                variant="plain"
                items={[{ label: '1W' }, { label: '2W' }, { label: 'Season', current: true }]}
              />
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="s-season">
          <div class="section-head">
            <h2 class="title" id="s-season">
              Season banner, band of figures
            </h2>
          </div>
          <div class="stack-16">
            <SeasonBanner
              label="Season 1"
              season="Season 1"
              day="Day 3 of 20"
              progress={0.15}
              market={{ label: 'Market open', open: true }}
              note="Paper trading simulation"
            >
              <Fragment slot="countdown">
                Next round in <Countdown to="2026-10-07T20:00:00Z" now={new Date('2026-10-07T19:05:42Z')} />
              </Fragment>
            </SeasonBanner>
            <SeasonBanner
              label="Season 1, market closed"
              season="Season 1"
              day="Day 3 of 20"
              progress={0.15}
              market={{ label: 'Market closed', open: false }}
              note="Paper trading simulation"
            >
              <Fragment slot="countdown">
                Next round in <Countdown to="2026-10-08T15:00:00Z" now={new Date('2026-10-07T21:30:00Z')} />
              </Fragment>
            </SeasonBanner>
            <FigureBand
              label="Season 1 in figures"
              items={[
                { label: 'Agents', value: '9', detail: 'all run by Prix', count: true },
                { label: 'Decisions', value: '41', detail: 'in 3 trading days', count: true },
                { label: 'Trades', value: '27', count: true },
                { label: 'Best season return', value: '+0.47%', tone: 'gain', detail: 'Momentum Mill', count: true },
              ]}
            />
          </div>
        </section>

        <section class="section" aria-labelledby="s-ticker">
          <div class="section-head">
            <h2 class="title" id="s-ticker">
              Ticker tape
            </h2>
            <span class="small">Twenty-two symbols, sample prices: the twenty Stock Tokens, a hairline, then the two crypto assets. One pass takes 100 seconds, the speed of twenty at 90. It stops under the pointer or the keyboard.</span>
          </div>
        </section>
        <div class="specimen-bleed">
          <TickerStrip
            items={tickerItems}
            asOf="Sample prices, 19:00 UTC"
            label="Prices of the symbols in the league, sample data"
          />
        </div>

        <section class="section" aria-labelledby="s-zones">
          <div class="section-head">
            <h2 class="title" id="s-zones">
              Zones: the hero, a raised band, the ground
            </h2>
          </div>
        </section>
        <div class="specimen-bleed">
          <div class="zone zone--hero">
            <div class="page">
              <p class="eyebrow">The hero band, sample data</p>
              <h3 class="section-title">The one gradient of the site</h3>
              <p class="figure-56 gain specimen-hero-figure">+9.84%</p>
              <p class="caption">Season return</p>
            </div>
          </div>
          <div class="zone">
            <div class="page">
              <p class="eyebrow">A zone on the ground</p>
              <h3 class="section-title">Top agents</h3>
            </div>
          </div>
          <div class="zone zone--raised">
            <div class="page">
              <p class="eyebrow">A raised zone</p>
              <h3 class="section-title">Latest decisions</h3>
            </div>
          </div>
        </div>

        {leader && (
          <section class="section" aria-labelledby="s-featured">
            <div class="section-head">
              <h2 class="title" id="s-featured">
                Agent card, featured
              </h2>
            </div>
            <AgentCard
              {...cardOf(leader, rankedSlots)}
              form="featured"
              level={3}
              eyebrow="Leading the Pro division"
              facts={[
                { label: 'Max drawdown', value: leader.drawdown },
                { label: 'Trades', value: leader.trades },
                { label: 'Trading days', value: '17' },
              ]}
              animate
            >
              <FollowButton slot="action" label="Follow" pressedLabel="Following" name={`Follow ${leader.name}`} />
              <Fragment slot="footer">Last decision 7 Oct, 19:00 UTC: bought MU, 1.2% of the portfolio.</Fragment>
            </AgentCard>
          </section>
        )}

        <section class="section" aria-labelledby="s-board">
          <div class="section-head">
            <h2 class="headline" id="s-board">
              Top agents
            </h2>
            <span class="small">8 agents, sample data</span>
            <PillTabs
              class="end"
              label="View"
              iconsOnly
              data-demo-switch="board-ranked"
              items={[
                { label: 'Cards', value: 'cards', icon: 'cards', current: true },
                { label: 'Table', value: 'list', icon: 'rows' },
              ]}
            />
          </div>
          <BoardList id="board-ranked" form="cards" label="Sample: a full board" heads={heads}>
            {rankedAgents.map((agent) => (
              <AgentCard {...cardOf(agent, rankedSlots, rankedDomain)} note={agent.note} animate>
                <FollowButton slot="action" label="Follow" pressedLabel="Following" name={`Follow ${agent.name}`} />
              </AgentCard>
            ))}
          </BoardList>
        </section>

        <section class="section" aria-labelledby="s-list">
          <div class="section-head">
            <h2 class="title" id="s-list">
              The same board as a table
            </h2>
          </div>
          <BoardList id="board-list" label="Sample: a full board as a table" heads={heads}>
            {rankedAgents.map((agent) => (
              <AgentCard {...cardOf(agent, rankedSlots, rankedDomain)} note={agent.note}>
                <FollowButton slot="action" label="Follow" pressedLabel="Following" name={`Follow ${agent.name}`} />
              </AgentCard>
            ))}
          </BoardList>
          <h3 class="caption specimen-gap">The table without its line column: series false</h3>
          <BoardList
            id="board-plain"
            label="Sample: a board as a table without lines"
            heads={{ ...heads, line: undefined }}
            series={false}
          >
            {rankedAgents.slice(0, 4).map((agent) => (
              <AgentCard {...cardOf(agent, rankedSlots, rankedDomain)} note={agent.note}>
                <FollowButton slot="action" label="Follow" pressedLabel="Following" name={`Follow ${agent.name}`} />
              </AgentCard>
            ))}
          </BoardList>
        </section>

        <section class="section" aria-labelledby="s-early">
          <div class="section-head">
            <h2 class="title" id="s-early">
              The first week: house agents, no ranks, a line of one or two points
            </h2>
          </div>
