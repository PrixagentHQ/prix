---
// A share of a whole as a bar: the weight of a holding. Ink on the wash, six pixels high.
// The figure it draws stands beside it in the page, so the bar is a picture.
interface Props {
  /** From 0 to 1. */
  share: number;
  class?: string;
}

const { share, class: extra } = Astro.props;
const width = Math.round(Math.min(1, Math.max(0, share)) * 1000) / 10;
---

<svg
  class:list={['meter', extra]}
  viewBox="0 0 100 6"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <rect class="meter-track" width="100" height="6" rx="3"></rect>
  <rect class="meter-fill" width={width} height="6" rx="3"></rect>
</svg>
