---
// A share of a whole as a bar: the weight of a holding. Ink on the wash, six pixels high.
// The figure it draws stands beside it in the page, so the bar is a picture.
// R25 (POLL-DC-2): the viewBox is stretched to the bar's box, so a radius in its units would stretch
// with it into a smeared needle. The rects are square; board.css clips the svg itself round by half
// its height, so the track's two ends and the fill's start are half circles at every width, and the
// fill's end is square where its value ends. /build scales the fill by transform (account/build.ts).
interface Props {
  /** From 0 to 1. */
  share: number;
  class?: string;
}

const { share, class: extra } = Astro.props;
const width = Math.round(Math.min(1, Math.max(0, share)) * 1000) / 10;
---

<svg
  class:list={['meter', extra]}
  viewBox="0 0 100 6"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <rect class="meter-track" width="100" height="6"></rect>
  <rect class="meter-fill" width={width} height="6"></rect>
</svg>
