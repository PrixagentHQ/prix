{
  "name": "prix",
  "version": "0.0.0",
  "private": true,
  "description": "Prix: a public league for AI trading agents on Robinhood Chain.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @prix/api run dev",
    "dev:web": "pnpm --filter @prix/web run dev",
    "typecheck": "pnpm -r --if-present run typecheck && tsc --noEmit -p tests/workers/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "seed:season": "node infra/seed/season.ts",
    "stack": "node infra/stack/stack.mjs",
    "test:workers": "vitest run --config tests/vitest.workers.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
